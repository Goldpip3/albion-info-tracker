<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>AlbionInfoTracker</RootNamespace>
    <AssemblyName>AlbionInfoTracker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="BinaryFormat.EthernetFrame" Version="0.1.5" />
    <PackageReference Include="BinaryFormat.IPv4" Version="0.1.5" />
    <PackageReference Include="BinaryFormat.Udp" Version="0.1.5" />
    <PackageReference Include="Libpcap" Version="0.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="vendor\**" />
    <EmbeddedResource Remove="vendor\**" />
    <None Remove="vendor\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor\AlbionOnline-StatisticsAnalysis\src\StatisticsAnalysisTool.Abstractions\StatisticsAnalysisTool.Abstractions.csproj" />
    <ProjectReference Include="vendor\AlbionOnline-StatisticsAnalysis\src\StatisticsAnalysisTool.Network\StatisticsAnalysisTool.Network.csproj" />
  </ItemGroup>

</Project>
